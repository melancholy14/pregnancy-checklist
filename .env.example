NEXT_PUBLIC_GA_MEASUREMENT_ID=        # GA4 측정 ID (G-XXXXXXXXXX)
NEXT_PUBLIC_ADSENSE_CLIENT_ID=        # AdSense 클라이언트 ID (ca-pub-XXXXXXXXXX)
YOUTUBE_API_KEY=                      # YouTube Data API v3 키 (채널 썸네일 수집용)
GA4_PROPERTY_ID=                      # GA4 Property ID (숫자, weekly-report 스크립트)
GA4_SA_KEY_PATH=                      # GA4 Service Account JSON 절대경로 (예: ~/.config/pregnancy-checklist/ga4-sa.json, mode 0600)
ANTHROPIC_API_KEY=                    # Claude API 키 (weekly-report 1순위 LLM). 미설정 시 OpenAI fallback
OPENAI_API_KEY=                       # OpenAI API 키 (weekly-report 2순위 — Claude 미설정/실패 시 사용, gpt-4o)
